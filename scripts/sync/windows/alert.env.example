# Optional email delivery for Check-ClaudeConfig.ps1.
# Copy to alert.env in this directory (gitignored) and fill in. With no alert.env the
# check still runs and still logs; drift is also visible in Task Scheduler's
# "Last Run Result" (0 = in sync, 1 = drift).
#
# The script sends plain SMTP with no login, so this suits a local relay. Never put a
# password in this file.

CLAUDE_CHECK_SMTP_HOST=smtp.example.internal
CLAUDE_CHECK_SMTP_PORT=25
CLAUDE_CHECK_EMAIL_FROM=claude-check@example.com
CLAUDE_CHECK_EMAIL_TO=you@example.com
